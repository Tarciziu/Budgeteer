    "onboarding.welcome.slide1.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track your spending, see where your money goes and save more — no complicated spreadsheets."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urmărește cheltuielile, vezi unde îți duci banii și economisește mai mult, fără tabele complicate."
          }
        }
      }
    },
    "onboarding.welcome.slide1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage your money, effortlessly"
