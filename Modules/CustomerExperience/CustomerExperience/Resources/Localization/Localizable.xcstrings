        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administrează-ți banii, fără efort"
          }
        }
      }
    },
    "onboarding.welcome.slide2.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your spending is sorted into categories automatically, so you can see at a glance what eats up most of your budget."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheltuielile tale sunt împărțite automat pe categorii, ca să vezi dintr-o privire ce consumă cel mai mult din buget."
          }
        }
      }
    },
    "onboarding.welcome.slide2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See exactly where your money goes"
