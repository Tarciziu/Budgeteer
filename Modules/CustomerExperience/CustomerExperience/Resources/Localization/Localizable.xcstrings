    },
    "onboarding.welcome.slide3.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick any 30-day window — say 6 June – 5 July — and track your progress the way it works for you."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege orice interval de 30 de zile — de exemplu 6 iunie – 5 iulie — și urmărește progresul exact cum funcționează pentru tine."
          }
        }
      }
    },
    "onboarding.welcome.slide3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budgets on your schedule, not the calendar's"
